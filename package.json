{
  "name": "memory-backbone",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, user-held, E2EE cross-agent memory with cryptographic per-agent grants",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/smlum666/cross-agent-memory.git"
  },
  "homepage": "https://github.com/smlum666/cross-agent-memory",
  "bugs": {
    "url": "https://github.com/smlum666/cross-agent-memory/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/sdk-core",
    "packages/cloud",
    "packages/mcp-server",
    "packages/adapters",
    "packages/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:cloud": "npm run dev --workspace @memory-backbone/cloud",
    "setup": "node scripts/setup.mjs",
    "clients": "node scripts/install-clients.mjs",
    "deploy:cf": "node scripts/deploy-cloudflare.mjs",
    "desktop": "npm start --workspace @memory-backbone/desktop",
    "e2e": "node scripts/e2e-selfhost.mjs",
    "revoke-demo": "node scripts/revoke-demo.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
